{
  "name": "@mediflow/server",
  "version": "0.1.0",
  "author": "sincalwow",
  "private": true,
  "type": "module",
  "main": "src/app.ts",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:pg": "node scripts/prisma-provider.mjs postgresql && prisma generate --schema prisma/schema.postgresql.prisma",
    "db:sql": "node scripts/gen-schema-sql.mjs",
    "db:push": "prisma db push --skip-generate",
    "seed": "tsx src/seed.ts",
    "import:clinicms": "tsx src/import-clinicms.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@fastify/jwt": "^9.1.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/static": "^8.3.0",
    "@mediflow/shared": "workspace:*",
    "@prisma/client": "~6.19.0",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "prisma": "~6.19.0",
    "tsx": "^4.20.0",
    "vitest": "^2.1.9"
  }
}
